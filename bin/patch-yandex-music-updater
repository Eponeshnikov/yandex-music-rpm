#!/usr/bin/env python3
"""Point Yandex Music's in-app updater at an RPM-friendly install command.

The app bundles electron-updater, whose DebUpdater hardcodes

    const cmd = ["dpkg", "-i", installerPath, "||", "apt-get", "install", "-f", "-y"];

inside resources/app.asar. On an RPM system that command is meaningless — there
is no apt and no dpkg database — so the app's "Обновить" button pops a polkit
prompt and then fails.

This replaces that array, in place and byte-for-byte the same length (so the
asar header's offsets and sizes stay valid, no repacking needed), with a call to
yandex-music-install, which converts the .deb with alien and installs it with
dnf. The app spawns the command with shell:true as

    pkexec /bin/bash -c '<cmd>'

so a plain absolute path is all that is needed.

Re-run after every reinstall of the package; it is idempotent.
"""

import argparse
import subprocess
import sys
from pathlib import Path

HELPER = "/usr/local/bin/yandex-music-install"

ORIG = b'["dpkg", "-i", installerPath, "||", "apt-get", "install", "-f", "-y"]'
PATCHED = b'["' + HELPER.encode() + b'", installerPath]'
# Padding keeps the byte length identical; trailing spaces before ] are valid JS
# and add no element to the array.
PATCHED += b" " * (len(ORIG) - len(PATCHED))
assert len(PATCHED) == len(ORIG), "replacement must not change the file size"


def find_asar() -> Path:
    """Locate app.asar: ask rpm first, then fall back to the usual /opt layout."""
    try:
        out = subprocess.run(
            ["rpm", "-ql", "yandexmusic"],
            capture_output=True, text=True, check=True,
        ).stdout
        for line in out.splitlines():
            if line.endswith("resources/app.asar"):
                return Path(line)
    except (OSError, subprocess.CalledProcessError):
        pass

    for candidate in sorted(Path("/opt").glob("*/resources/app.asar")):
        if "музык" in candidate.parts[2].lower() or "music" in candidate.parts[2].lower():
            return candidate

    sys.exit("patch-yandex-music-updater: could not find app.asar, pass --asar")


def find_one(data: bytes, needle: bytes, label: str) -> int:
    hits = []
    start = 0
    while (i := data.find(needle, start)) != -1:
        hits.append(i)
        start = i + 1
    if len(hits) > 1:
        sys.exit(
            f"patch-yandex-music-updater: {len(hits)} {label} occurrences, refusing to guess"
        )
    return hits[0] if hits else -1


def main() -> int:
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    ap.add_argument("--revert", action="store_true", help="restore the stock dpkg command")
    ap.add_argument("--check", action="store_true", help="report status only, change nothing")
    ap.add_argument("--asar", type=Path, help="path to app.asar (default: autodetect)")
    args = ap.parse_args()

    asar = args.asar or find_asar()
    if not asar.is_file():
        sys.exit(f"patch-yandex-music-updater: not found: {asar}")

    data = asar.read_bytes()
    at_orig = find_one(data, ORIG, "stock")
    at_patched = find_one(data, PATCHED, "patched")

    if args.check:
        if at_patched != -1:
            print(f"patched (offset {at_patched}) -> {HELPER}")
            return 0
        if at_orig != -1:
            print(f"stock (offset {at_orig}) -> dpkg/apt-get")
            return 1
        print("unknown: neither the stock nor the patched command was found")
        return 2

    want, have, at = (
        (ORIG, PATCHED, at_patched) if args.revert else (PATCHED, ORIG, at_orig)
    )

    if at == -1:
        if find_one(data, want, "target") != -1:
            print("patch-yandex-music-updater: already in the requested state")
            return 0
        sys.exit(
            "patch-yandex-music-updater: install command not found — upstream probably "
            "changed it; re-check DebUpdater inside app.asar"
        )

    if not args.revert and not Path(HELPER).is_file():
        sys.exit(f"patch-yandex-music-updater: helper missing: {HELPER}")

    try:
        with asar.open("r+b") as fh:
            fh.seek(at)
            if fh.read(len(have)) != have:
                sys.exit("patch-yandex-music-updater: unexpected bytes at offset, aborting")
            fh.seek(at)
            fh.write(want)
    except PermissionError:
        sys.exit(f"patch-yandex-music-updater: need root to write {asar}")

    action = "reverted" if args.revert else "patched"
    print(f"patch-yandex-music-updater: {action} {asar} at offset {at}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
