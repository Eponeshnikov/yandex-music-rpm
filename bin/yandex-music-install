#!/usr/bin/env bash
# Install a Yandex Music .deb on an RPM-based system.
#
# Runs as root. Converts the package to an RPM (alien, or eepm's own repack on
# ALT Linux), installs it with the distribution's package manager, then
# re-applies the app.asar patch so the app's own "Обновить" button keeps landing
# here instead of on dpkg/apt-get.
#
# Called both by yandex-music-update (with --foreground) and by the patched app
# itself through `pkexec /bin/bash -c '<this> <deb>'`. The app runs that command
# with a *synchronous* spawnSync, so the default mode detaches a worker and
# returns at once — otherwise the whole UI freezes for the minute or two the
# conversion takes and the desktop offers to force-quit it, which kills the
# install halfway through.
set -Eeuo pipefail

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LOG="${YM_LOG:-/var/log/yandex-music-install.log}"
PATCHER=/usr/local/bin/patch-yandex-music-updater
LOCK="${YM_LOCK:-/run/yandex-music-install.lock}"

# The shared package-manager layer: installed copy first, repo checkout second.
ym_lib_path() {
  local self_dir candidate
  self_dir="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
  for candidate in "${YM_LIB:-}" /usr/local/lib/yandex-music-rpm/common.sh \
                   "$self_dir/../lib/ym-common.sh" "$self_dir/lib/ym-common.sh"; do
    [[ -n "$candidate" && -r "$candidate" ]] && { printf '%s\n' "$candidate"; return 0; }
  done
  return 1
}
YM_LIB="$(ym_lib_path)" || { printf 'error: ym-common.sh not found\n' >&2; exit 1; }
# shellcheck source=/dev/null
. "$YM_LIB"
APP_BIN="${YM_APP_BIN:-/usr/bin/yandexmusic}"
APP_DIR="${YM_APP_DIR:-/opt/Яндекс Музыка}"

mode=detach   # detach | foreground | worker
do_patch=1
deb=""

usage() {
  cat <<'EOF'
Usage: yandex-music-install [--foreground] [--no-patch] <Yandex_Music_amd64_X.Y.Z.deb>

Converts the .deb to an RPM and installs it with the distribution's package
manager. Must run as root. Re-applies the in-app updater patch afterwards
unless --no-patch.

  --foreground  Do the work in this process and print progress (used by
                yandex-music-update). The default detaches a background worker,
                restarts the app when the install is done and returns
                immediately, which is what the app's own updater needs.
EOF
}

log() {
  local line
  line="$(date -Is) [yandex-music-install] $*"
  printf '%s\n' "$line"
  # The install steps run with stdout already pointed at the log; appending a
  # second copy from here would double every line they write.
  [[ /dev/stdout -ef "$LOG" ]] || printf '%s\n' "$line" >>"$LOG" 2>/dev/null || true
}

die() {
  log "error: $*"
  exit 1
}

while (($#)); do
  case "$1" in
    --foreground) mode=foreground ;;
    --worker) mode=worker ;;
    --no-patch) do_patch=0 ;;
    -h|--help) usage; exit 0 ;;
    -*) die "unknown argument: $1" ;;
    *) [[ -z "$deb" ]] || die "expected exactly one .deb path"; deb="$1" ;;
  esac
  shift
done

[[ $EUID -eq 0 ]] || die "must run as root"
[[ -n "$deb" ]] || { usage >&2; exit 2; }
[[ -f "$deb" ]] || die "not a file: $deb"
[[ "$(basename -- "$deb")" =~ ^Yandex_Music_amd64_.+\.deb$ ]] \
  || die "refusing to install unexpected package: $deb"

ym_require_deps || exit 1

# --- session helpers, for the detached worker ------------------------------

# Match on the executable behind each pid, not on the command line: every
# Electron helper process (gpu, zygote, renderers) runs the same binary, and a
# command line can be matched by accident — including our own.
app_pids() {
  local proc exe pids=()
  for proc in /proc/[0-9]*; do
    exe="$(readlink -f "$proc/exe" 2>/dev/null || true)"
    [[ "$exe" == "$APP_DIR"/* ]] && pids+=("${proc#/proc/}")
  done
  ((${#pids[@]})) && printf '%s\n' "${pids[@]}"
  return 0
}

# Who is behind this install: pkexec says so directly; otherwise fall back to
# the running app, and finally to whoever owns the .deb — the app downloads it
# into its own user's cache.
caller_uid() {
  local pid uid=""
  [[ -n "${PKEXEC_UID:-}" ]] && { printf '%s\n' "$PKEXEC_UID"; return 0; }
  for pid in $(app_pids); do
    uid="$(stat -c %u "/proc/$pid" 2>/dev/null || true)"
    [[ -n "$uid" ]] && break
  done
  [[ -n "$uid" ]] || uid="$(stat -c %u -- "$deb" 2>/dev/null || true)"
  [[ -n "$uid" ]] || return 1
  printf '%s\n' "$uid"
}

# The user bus is all that notify-send and systemd-run --user need, and it is
# derivable from the uid alone — the app's own environment is gone by the time
# the update finishes. DISPLAY/WAYLAND_DISPLAY are picked up as a bonus while
# the app is still alive; without them systemd-run --user still works, because
# the session imports them into the user manager itself.
capture_session() {
  local pid environ value var
  session_env=()
  session_uid="${YM_UID:-}"
  [[ -n "$session_uid" ]] || session_uid="$(caller_uid || true)"
  [[ -n "$session_uid" && "$session_uid" != 0 ]] || return 1
  session_user="$(id -nu "$session_uid" 2>/dev/null)" || return 1
  session_env=(
    "XDG_RUNTIME_DIR=/run/user/$session_uid"
    "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$session_uid/bus"
  )
  for pid in $(app_pids); do
    [[ -r "/proc/$pid/environ" ]] || continue
    environ="$(tr '\0' '\n' <"/proc/$pid/environ")"
    for var in DISPLAY WAYLAND_DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP LANG; do
      value="$(grep -m1 "^$var=" <<<"$environ" || true)"
      [[ -n "$value" ]] && session_env+=("$value")
    done
    break
  done
  [[ -d "/run/user/$session_uid" ]] || return 1
}

run_as_user() {
  [[ -n "${session_user:-}" ]] || return 1
  runuser -u "$session_user" -- env "${session_env[@]}" "$@"
}

notify() {
  run_as_user notify-send -a "Яндекс Музыка" -i yandexmusic "$@" >/dev/null 2>&1 || true
}

# Hand the app to the user's own systemd manager. Starting it as a child of
# this worker would not do: the worker is a transient unit, and everything left
# in its cgroup dies the moment it exits.
relaunch_app() {
  local unit="yandex-music-$(date +%s)" args=() kv
  [[ -x "$APP_BIN" ]] || APP_BIN="$APP_DIR/yandexmusic"
  for kv in "${session_env[@]}"; do args+=(--setenv="$kv"); done
  if run_as_user systemd-run --user --quiet --collect --unit="$unit" \
       "${args[@]}" -- "$APP_BIN" >>"$LOG" 2>&1; then
    return 0
  fi
  log "warning: could not restart the app, start it from the menu"
  return 1
}

stop_app() {
  local pids deadline
  pids="$(app_pids)"
  [[ -n "$pids" ]] || return 0
  log "stopping the running app"
  # shellcheck disable=SC2086
  kill -TERM $pids 2>/dev/null || true
  deadline=$((SECONDS + 8))
  while [[ -n "$(app_pids)" ]] && ((SECONDS < deadline)); do sleep 1; done
  pids="$(app_pids)"
  if [[ -n "$pids" ]]; then
    # shellcheck disable=SC2086
    kill -KILL $pids 2>/dev/null || true
    sleep 1
  fi
}

# --- serialization ---------------------------------------------------------

# Two clicks on "Обновить" start two installs of the same .deb; without a lock
# the second one kills the app the first one has just restarted and then trips
# over the package file the first one already consumed.
take_lock() {
  exec 9>"$LOCK"
  if ! flock -n 9; then
    log "another install is running, waiting for it"
    flock -w 900 9 || die "timed out waiting for the running install"
  fi
}

deb_version() {
  sed -E 's/^Yandex_Music_amd64_(.+)\.deb$/\1/' <<<"$(basename -- "$deb")"
}

installed_version() { ym_installed_version; }

drop_pending_deb() {
  [[ "$deb" == */yandexmusic-updater/pending/* ]] && rm -f -- "$deb"
  return 0
}

# --- the actual install ----------------------------------------------------

do_install() {
  log "installing $deb"

  workdir="$(mktemp -d -t yandex-music-install.XXXXXX)"
  trap 'rm -rf "$workdir"' EXIT

  cp -- "$deb" "$workdir/" || die "could not read $deb"

  ym_install_deb "$workdir/$(basename -- "$deb")" "$workdir" >>"$LOG" 2>&1 \
    || die "install failed, see $LOG"

  if ((do_patch)) && [[ -x "$PATCHER" ]]; then
    log "re-applying in-app updater patch"
    "$PATCHER" >>"$LOG" 2>&1 || log "warning: patch failed, see $LOG"
  fi
}

case "$mode" in
  detach)
    # Fully detach: the app captures our stdout with a synchronous spawn, so an
    # inherited pipe would keep it blocked no matter that we already exited.
    worker_args=(--worker)
    ((do_patch)) || worker_args+=(--no-patch)
    if command -v systemd-run >/dev/null 2>&1; then
      # A transient unit leaves the app's cgroup behind, so the install survives
      # the app quitting — or the desktop force-quitting it.
      # systemd-run hands the worker a clean environment, so the one thing it
      # cannot rediscover on its own — who asked for this — goes in explicitly.
      systemd-run --quiet --collect \
        --property=KillMode=process \
        --setenv="YM_UID=$(caller_uid)" \
        --unit="yandex-music-install-$(date +%s)" \
        --description="Yandex Music update" \
        -- "$0" "${worker_args[@]}" "$deb"
    else
      setsid "$0" "${worker_args[@]}" "$deb" </dev/null >>"$LOG" 2>&1 &
    fi
    exit 0
    ;;
  foreground)
    take_lock
    do_install
    log "done"
    ;;
  worker)
    take_lock
    # By the time the lock is free, an earlier run may have done this already.
    if [[ ! -f "$deb" ]]; then
      log "nothing to do: $deb is gone, another run has consumed it"
      exit 0
    fi
    if [[ "$(installed_version)" == "$(deb_version)" ]]; then
      log "nothing to do: $(deb_version) is already installed"
      drop_pending_deb
      exit 0
    fi
    capture_session || log "warning: could not determine the user session"
    notify "Обновление" "Устанавливается новая версия…"
    # The patched app quits without relaunching itself, so this is just time for
    # it to go away on its own; stop_app is the safety net for an instance that
    # refuses to, which must not be left running on top of the files dnf is
    # about to replace.
    sleep 5
    stop_app
    # A subshell so a failure inside do_install lands here instead of exiting.
    if ( do_install ); then
      version="$(installed_version)"
      drop_pending_deb
      log "restarting the app"
      relaunch_app
      notify "Обновление установлено" "Яндекс Музыка ${version:-обновлена}"
    else
      notify "Не удалось обновить" "Подробности: $LOG"
      # Nothing relaunches the app any more, so bring the old version back.
      relaunch_app || true
    fi
    log "done"
    ;;
esac
